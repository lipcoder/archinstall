{
    "files.autoSave": "afterDelay",
    "editor.mouseWheelZoom": true,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "editor.formatOnSave": true,
    "jdk.telemetry.enabled": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "update.showReleaseNotes": false,
    "workbench.secondarySideBar.defaultVisibility": "visible",
    "chat.allowAnonymousAccess": true,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "git.confirmSync": false,
    "liveServer.settings.donotShowInfoMsg": true,
    "chat.agent.codeBlockProgress": false,
    "chat.agent.thinking.collapsedTools": "off",
    "chat.agent.thinkingStyle": "collapsed",
    "json.schemas": [
        {
            "fileMatch": [
                "/.docx.json"
            ],
            "url": "https://raw.githubusercontent.com/Mehdi-Verfaillie/docx/main/src/config/.docx.schema.json"
        }
    ],
    "window.zoomLevel": 1,
    "editor.minimap.enabled": false,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "/usr/bin/bash"
        },
        "zsh": {
            "path": "zsh"
        },
        "fish": {
            "path": "/usr/bin/fish"
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        }
    },
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.initialHint": false,
    "terminal.integrated.cwd": "",
    "workbench.panel.defaultLocation": "right",
    "workbench.settings.applyToAllProfiles": [],
    "python-envs.terminal.autoActivationType": "off",
    "python.terminal.activateEnvironment": false,
    "python.terminal.activateEnvInCurrentTerminal": false,
    "terminal.integrated.fontFamily": "monospace",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.lineHeight": 1.0,
    "terminal.integrated.letterSpacing": 0,
    "security.workspace.trust.untrustedFiles": "open",
    "vscode-office.editorTheme": "One Dark",
    "github.copilot.nextEditSuggestions.eagerness": "low",
    "chat.viewSessions.orientation": "stacked"
}